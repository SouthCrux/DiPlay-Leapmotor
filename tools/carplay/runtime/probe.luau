-- Calls the original accessory wrappers; this test scene is not an Ultra dashboard.
local Rect=require("APL.Rect")
local Transform=require("APL.Transform")
local Layer=require("APL.Layer")
local JSON=require("APL.json")
local Asset=require("APL.Asset")
local Texture=require("APL.Texture")
local ImageLayer=require("APL.ImageLayer")
local ShapeLayer=require("APL.ShapeLayer")
local Path=require("APL.Path")
local Thread=require("APL.Thread")
Offscreen.configureOutput("Center_Display",640,360)
local stages=0
local worker=Thread.new(function()stages+=1;Thread.yield();stages+=1 end):start()
assert(worker:isBusy() and stages==0)
Offscreen.runTasks(1);assert(stages==1 and worker:isBusy())
Offscreen.runTasks(1);assert(stages==2 and not worker:isBusy())
local package=require("r/PackageData")
assert(package.identifier=="44C9FA31EC" and package.version==985,"unexpected research package")
local center
for _,display in package.displays do if display.id=="Center_Display" then center=display end end
assert(center,"center display absent")
Asset.setManifest("AssetManifestData","r/Center_Display")
local imageName=Asset.lookupAssetFilename(center.appleLogo.type.image._0.identifier)
local texture=Texture.new(imageName)
assert(texture,"resource image unavailable")
local moved=Rect.new(10,20,30,40):transform(Transform.newWithTranslation(3,7))
local x,y,w,h=moved:getBounds()
assert(x==13 and y==27 and w==30 and h==40,"original Rect/Transform wrapper failed")
local root=Layer.new():setFrame(0,0,640,360):setBackgroundColor("#101820ff")
local child=Layer.new():setFrame(40,50,200,100):setBackgroundColor("#1677ccff")
root:addSublayer(child)
local grandchild=Layer.new():setFrame(20,20,80,40):setBackgroundColor("#ffbb00ff")
child:addSublayer(grandchild)
assert(root:isSublayer(child))
local px,py=child:getPosition();assert(px==140 and py==100)
child:setOpacity(0.75);assert(child:getOpacity()==0.75)
local imageWidth,imageHeight=texture:getSize()
local image=ImageLayer.new():setFrame(320,60,280,280*imageHeight/imageWidth):setTexture(texture)
root:addSublayer(image)
local shape=ShapeLayer.new():setFrame(320,180,100,100)
shape:setPath(Path.new():ellipseIn(Rect.new(5,5,90,90)))
shape:setFillColor("#125533ff"):setStrokeColor("#55dd99ff"):setLineWidth(4)
root:addSublayer(shape)
local ok=pcall(function()grandchild:addSublayer(root)end);assert(not ok,"cycle accepted")
CP.setRootLayer("Center_Display",root:getNativeLayer())
return JSON.encode({fixture=true,fullUltraUI=false,originalWrappersExecuted=true,
    resourceIdentifier=package.identifier,resourceVersion=package.version,scene=Offscreen.snapshot()})
